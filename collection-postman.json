      "name": "Status",
      "item": [
        {
          "name": "GET /status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/status"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "POST /auth/register (sucesso)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Funcionário Teste\",\n  \"email\": \"funcionario.teste@email.com\",\n  \"senha\": \"senha123\",\n  \"tel\": \"11999999999\",\n  \"role\": \"Attendant\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 no cadastro de funcionário', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Retorna dados do funcionário sem senha', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.employee).to.be.an('object');",
                  "  pm.expect(json.employee.password).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST /auth/login (sucesso)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"funcionario.teste@email.com\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 no login', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna token JWT', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.expect(json.token.length).to.be.above(0);",
                  "  pm.environment.set('token', json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST /auth/login (erro - credenciais inválidas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"naoexiste@email.com\",\n  \"senha\": \"senhaerrada\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 em credenciais inválidas', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Cardápio (Menu)",
      "item": [
        {
          "name": "POST /menu (sucesso)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Prato Teste\",\n  \"description\": \"Um prato delicioso para testes\",\n  \"price\": 35,\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/menu"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 ao cadastrar prato', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Salva o id do prato criado', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.environment.set('menuId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /menu (sucesso)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/menu"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 na listagem do cardápio', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna array de pratos', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('data').that.is.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /menu/:id (sucesso)",
          "request": {
